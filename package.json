    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "mapbox-gl": "^3.18.1",
    "next": "16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sileo": "^0.1.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
